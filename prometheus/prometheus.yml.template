# =============================================================================
# Configuracao do Prometheus (template)
# =============================================================================
# ${API_TARGET}, ${API_SCHEME} e ${SCRAPE_INTERVAL} sao substituidos pelo
# entrypoint.sh (via envsubst) a partir das variaveis de ambiente do
# container. Em desenvolvimento local (docker-compose), veja prometheus.yml.
# =============================================================================
global:
  scrape_interval: ${SCRAPE_INTERVAL}
  evaluation_interval: ${SCRAPE_INTERVAL}

rule_files:
  - "alerts.yml"

scrape_configs:
  - job_name: "api-churn"
    scheme: ${API_SCHEME}
    metrics_path: /metrics
    static_configs:
      - targets: ["${API_TARGET}"]
