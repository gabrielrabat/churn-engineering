# Copie este arquivo para .env e ajuste os valores para rodar localmente.
# Nenhum destes defaults deve ser usado em producao real.

# --- Aplicacao ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Modelo ---
MODEL_PATH=models/champion_model.joblib
MODEL_VERSION=1.0.0

# --- Seguranca / JWT ---
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Usuario de demonstracao (trocar por banco de usuarios em producao real) ---
DEMO_USER=admin
DEMO_PASSWORD=secret123

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_BATCH=10/minute
RATE_LIMIT_LOGIN=10/minute

# --- Predicao em lote ---
BATCH_MAX_ITEMS=100

# --- Metricas / CORS ---
METRICS_ENABLED=true
CORS_ORIGINS=*
